{
  "name": "netbox-sre-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "True Tool-Calling SRE Agent over netbox-docker (Phase 1: L1 static).",
  "scripts": {
    "env-check": "node src/run-agent.mjs --env-check",
    "demo:static": "node src/run-agent.mjs",
    "replay": "node src/run-agent.mjs --replay",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/contract/**/*.test.mjs\" \"tests/replay/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:contract": "node --test \"tests/contract/**/*.test.mjs\"",
    "test:replay": "node --test \"tests/replay/**/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "js-yaml": "^4.1.0",
    "typebox": "^1.3.7"
  }
}
